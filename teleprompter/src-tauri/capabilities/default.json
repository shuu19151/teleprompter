{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "dialog:default",
    "android-documents:allow-ensureMicrophonePermission",
    "android-documents:allow-shareTake",
    "android-documents:allow-pickDirectory",
    "android-documents:allow-getSavedDirectory",
    "android-documents:allow-consumePendingImport",
    "android-documents:allow-listTexts",
    "android-documents:allow-readText",
    "android-documents:allow-writeText",
    "android-documents:allow-deleteText",
    "android-documents:allow-registerListener",
    "android-documents:allow-removeListener",
    "fs:allow-read-dir",
    "fs:allow-read-text-file",
    "fs:allow-remove",
    "opener:allow-reveal-item-in-dir",
    "allow-recorder-start",
    "allow-recorder-pause",
    "allow-recorder-resume",
    "allow-recorder-stop",
    "allow-recorder-status",
    "allow-recorder-cancel",
    "allow-recorder-list-devices",
    "allow-recorder-recover",
    "allow-recorder-recover-apply",
    "allow-takes-list",
    "allow-takes-delete",
    "allow-takes-read",
    "allow-texts-list",
    "allow-texts-read",
    "allow-texts-write",
    "allow-texts-delete",
    "allow-texts-folder",
    {
      "identifier": "fs:allow-mkdir",
      "allow": [{ "path": "$DOCUMENT/Teleprompter" }]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [
        { "path": "$DOCUMENT/Teleprompter" },
        { "path": "$DOCUMENT/Teleprompter/*" }
      ]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [
        { "path": "$DOCUMENT/Teleprompter" },
        { "path": "$DOCUMENT/Teleprompter/*" }
      ]
    }
  ]
}
